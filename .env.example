OLLAMA_MODEL=qwen2.5:latest
OLLAMA_API_KEY=your_ollama_api_key_here

# Tiger Cloud PostgreSQL / TimescaleDB Service
TIGER_SERVICE_ID=i9n4pdf1ga
TIGER_DATABASE_URL=postgresql://tsdbadmin:<YOUR_PASSWORD>@i9n4pdf1ga.qap2zrlxti.tsdb.cloud.timescale.com:32317/tsdb?sslmode=require

