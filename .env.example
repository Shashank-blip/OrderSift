# Ollama Configuration (Local development)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:latest
# OLLAMA_API_KEY=

# Groq Cloud (Recommended for Vercel/cloud deployment - Free open-weight Qwen 2.5)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen-2.5-32b

# Generic OpenAI-compatible endpoint (Optional: OpenRouter, Together AI)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=qwen/qwen-2.5-72b-instruct

# Tiger Cloud PostgreSQL / TimescaleDB Service
TIGER_SERVICE_ID=lp1tbu4c9d
TIGER_DATABASE_URL=postgresql://tsdbadmin:<YOUR_PASSWORD>@lp1tbu4c9d.qap2zrlxti.tsdb.cloud.timescale.com:31939/tsdb?sslmode=require
# Optional: PEM CA certificate to verify the server certificate (verify-full). Use \n for line breaks.
# TIGER_CA_CERT=

